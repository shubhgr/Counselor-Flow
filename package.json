{
  "name": "gradright-counselor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "preview": "next start --hostname 127.0.0.1",
    "predev": "node scripts/prepare-public.mjs",
    "prebuild": "node scripts/prepare-public.mjs",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src tests next.config.mjs postcss.config.mjs",
    "format:check": "prettier --check src tests next.config.mjs postcss.config.mjs"
  },
