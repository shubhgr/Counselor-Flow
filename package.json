    "glisse": "^0.5.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
